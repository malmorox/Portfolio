---
import PersonalImage from "@components/PersonalImage.astro";
import Button from "@components/ui/Button.astro";
import { HiArrowNarrowDown } from "react-icons/hi";
---
<section id="intro" class="hero" aria-labelledby="intro-title">
    <div class="hero-inner page-container">
        <div class="hero-text">
            <h1 id="intro-title" class="hero-title">
                <span class="title-small rise-in" style="--i: 0">
                    <span class="status-dot" aria-hidden="true"></span>
                    Marcos Almorox
                </span>
                <span class="title-big rise-in" style="--i: 1">
                    Desarrollador junior <span class="text-gradient">full-stack</span> español
                </span>
            </h1>
            <p class="hero-lead rise-in" style="--i: 2">
                Creo webs y apps con enfoque en rendimiento, usabilidad y diseño.
            </p>
            <div class="hero-actions rise-in" style="--i: 3">
                <Button href="#contact" size="lg">Ponte en contacto</Button>
                <Button href="#about" variant="ghost" size="lg">
                    Scrollea para ver más
                    <HiArrowNarrowDown aria-hidden="true" data-icon="down" />
                </Button>
            </div>
        </div>

        <div class="hero-media rise-in" style="--i: 2">
            <PersonalImage />
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: center;
        min-block-size: min(calc(100svh - var(--header-height)), 56rem);
        padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem);

        /* Fading decorative grid */
        &::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background-image:
                linear-gradient(to right, var(--color-border) 1px, transparent 1px),
                linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
            background-size: 4rem 4rem;
            mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, black, transparent 75%);
        }

        /* Orange glow behind the photo */
        &::after {
            content: "";
            position: absolute;
            inset-block-start: 10%;
            inset-inline-end: 5%;
            z-index: -1;
            inline-size: min(40rem, 70vw);
            aspect-ratio: 1;
            border-radius: 50%;
            background: radial-gradient(
                circle,
                color-mix(in oklab, var(--color-brand-500) 22%, transparent),
                transparent 65%
            );
            filter: blur(20px);
        }
    }

    .hero-inner {
        display: grid;
        align-items: center;
        gap: clamp(3rem, 2rem + 4vw, 5rem);

        @media (min-width: 56rem) {
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
        }
    }

    .hero-title {
        display: grid;
        gap: 1rem;
    }

    .title-small {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        color: var(--color-fg-subtle);
        font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
        font-weight: 600;
        letter-spacing: 0;
    }

    .status-dot {
        inline-size: 0.625rem;
        block-size: 0.625rem;
        border-radius: 50%;
        background-color: var(--color-accent);
        box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-brand-500) 25%, transparent);
    }

    .title-big {
        color: var(--color-fg);
        font-size: var(--text-display);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.035em;
    }

    .text-gradient {
        white-space: nowrap;
        background-size: 100% 200%;
        background-position-y: 100%;

        @media (prefers-reduced-motion: no-preference) {
            animation: gradient-pulse 3.3s ease-in-out infinite;
        }
    }

    @keyframes gradient-pulse {
        0%,
        100% {
            background-position-y: 0%;
        }
        50% {
            background-position-y: 80%;
        }
    }

    .hero-lead {
        max-inline-size: 30ch;
        margin-block-start: 1.75rem;
        color: var(--color-fg-muted);
        font-size: var(--text-lead);
        line-height: 1.4;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
        margin-block-start: 2.5rem;
    }

    .hero-media {
        justify-self: center;
        inline-size: min(100%, 26rem);

        @media (min-width: 56rem) {
            justify-self: end;
        }
    }
</style>
