---
import ProjectCard from '@components/ui/ProjectCard.astro'
import projectsData from '@data/projects.json'
import { HiArrowNarrowRight } from "react-icons/hi";

const projects = projectsData.projects.slice(0, 4);
---
<section id="projects">
    <div class="projects-container">
        <h2 class="projects-title"> Proyectos destacados </h2>
        <div class="works">
        {
            projects.map((project) => (
                <ProjectCard
                    name={project.name}
                    description={project.description}
                    imgLogo={project.img_logo}
                    imgPreview={project.img_preview}
                    technologies={project.technologies}
                    link={project.link}
                />
            ))
        }
        </div>
        <div class="btn-wrapper">
            <a href="/projects" class="btn-all-projects">
                Ver todos los proyectos
                <HiArrowNarrowRight className="btn-arrow" />
            </a>
        </div>
    </div>
</section>

<style>
    #projects {
        @apply pt-20 pb-28
    }

    .projects-container {
        @apply max-w-screen-xl mx-auto flex flex-col px-6
    }

    .projects-title {
        @apply text-5xl font-bold text-left mb-10;
        color: rgba(244, 114, 38, 0.7);
    }

    .works {
        @apply grid grid-cols-2 gap-7
    }

    .btn-wrapper {
        @apply flex justify-center mt-12;
    }

    .btn-all-projects {
        @apply flex items-center gap-2 px-8 py-3 font-semibold text-lg rounded-full transition-all duration-300;
        color: rgba(244, 114, 38, 0.8);
        border: 3px solid rgba(244, 114, 38, 0.7);
        background: transparent;
    }

    .btn-all-projects:hover {
        background: rgba(244, 114, 38, 0.1);
        border-color: rgba(244, 114, 38);
        color: rgba(244, 114, 38);
        transform: translateY(-2px);
    }

    .btn-arrow {
        @apply transition-transform duration-300 size-5;
        display: inline-block;
    }

    .btn-all-projects:hover .btn-arrow {
        transform: translateX(4px);
    }
</style>