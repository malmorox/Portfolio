---
import SectionHeader from '@components/ui/SectionHeader.astro'
import ProjectCard from '@components/ui/ProjectCard.astro'
import projectsData from '@data/projects.json'

interface Project {
    name: string
    description: string
    img_logo: string
    img_preview: string
    technologies: string[]
    /** Main destination: deployed site, store or repository */
    link: string
    /** Optional repository when `link` is a deployed site or a store */
    repo?: string
}

const projects: Project[] = projectsData.projects.slice(0, 4);

const projectsImagesPath = "/images/projects/"
const logoPath = `${projectsImagesPath}logo/`
const previewPath = `${projectsImagesPath}preview/`

/* Project images that exist in /public (resolved at build time) */
const existingImages = new Set(
    Object.keys(import.meta.glob('/public/images/projects/**/*.*', { query: '?url' }))
        .map((path) => path.replace(/^\/public/, ''))
)

/** Public path only if the file exists */
function publicAsset(path: string): string | undefined {
    return existingImages.has(path) ? path : undefined
}
---
<section id="projects" class="section-space" tabindex="-1" aria-labelledby="projects-title">
    <div class="page-container">
        <SectionHeader
            title="Proyectos destacados"
            id="projects-title"
        />

        <ul class="works">
            {projects.map((project) => (
                <li class="reveal">
                    <ProjectCard
                        name={project.name}
                        description={project.description}
                        imgLogo={publicAsset(`${logoPath}${project.img_logo}`)}
                        imgPreview={publicAsset(`${previewPath}${project.img_preview}`)}
                        technologies={project.technologies}
                        link={project.link}
                        repo={project.repo}
                    />
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .works {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
        gap: 1.5rem;
        list-style: none;

        & > li {
            display: grid;
        }
    }
</style>
