---
import TechnologyLabel from '@components/ui/TechnologyLabel.astro'
import { HiArrowUpRight } from 'react-icons/hi2'
import { FaGithub } from 'react-icons/fa'

interface ProjectProps {
	name: string
	description: string
	/** Logo path; falls back to the initial */
	imgLogo?: string
	/** Screenshot path; falls back to a brand background */
	imgPreview?: string
	technologies: string[]
	/** Main destination: deployed site, store or repository */
	link: string
	/** Repository, shown as a secondary link when `link` is not GitHub */
	repo?: string
}

const {
	name,
	description,
	imgLogo,
	imgPreview,
	technologies,
	link,
	repo
} = Astro.props as ProjectProps

const isGitHub = (url: string) => new URL(url).hostname.endsWith('github.com')

function linkLabel(url: string): string {
	const host = new URL(url).hostname
	if (isGitHub(url)) return 'Ver código en GitHub'
	if (host === 'play.google.com') return 'Ver en Google Play'
	if (host === 'apps.apple.com') return 'Ver en App Store'
	return 'Visitar web'
}

const label = linkLabel(link)
const showRepo = repo !== undefined && !isGitHub(link)
---
<article class="project">
	<div class:list={['project-media', { 'has-preview': imgPreview }]}>
		{imgPreview && (
			<img
				src={imgPreview}
				alt=""
				class="project-image-preview"
				loading="lazy"
				decoding="async"
			/>
		)}
		{imgLogo ? (
			<img
				src={imgLogo}
				alt=""
				class="project-image-logo"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<span class="project-monogram" aria-hidden="true">{name.charAt(0)}</span>
		)}
	</div>

	<div class="project-info">
		<h3 class="project-title">
			<a href={link} class="project-link" target="_blank" rel="noopener">
				{name}
				<span class="visually-hidden">: {label.toLowerCase()} (se abre en una pestaña nueva)</span>
			</a>
		</h3>
		<p class="project-description">{description}</p>

		<ul class="project-technologies" aria-label="Tecnologías">
			{technologies.map((tech: string) => <TechnologyLabel technology={tech} />)}
		</ul>

		<footer class="project-actions">
			<span class="project-cta" aria-hidden="true">
				{label}
				<HiArrowUpRight className="project-cta-icon" />
			</span>

			{showRepo && (
				<a href={repo} class="project-repo" target="_blank" rel="noopener">
					<FaGithub className="project-repo-icon" aria-hidden="true" />
					Código<span class="visually-hidden"> de {name} en GitHub (se abre en una pestaña nueva)</span>
				</a>
			)}
		</footer>
	</div>
</article>

<style>
	.project {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card-brand);
		background-color: var(--color-surface);
		box-shadow: var(--shadow-card);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			translate 0.4s var(--ease-out-expo);

		/* Hover on the stretched main link, not on the repo link */
		&:has(.project-link:hover) {
			border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
			box-shadow: var(--shadow-card), 0 24px 48px -28px rgb(244 114 38 / 0.45);

			@media (prefers-reduced-motion: no-preference) {
				translate: 0 -0.375rem;
			}
		}

		/* Whole card is clickable: show focus on it */
		&:has(.project-link:focus-visible) {
			outline: 2px solid var(--color-accent);
			outline-offset: 3px;
		}
	}

	/* ---------- Media ---------- */
	.project-media {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-block-end: 1px solid var(--color-border);
		/* Brand background when there is no screenshot */
		background:
			radial-gradient(circle at 25% 15%, color-mix(in oklab, var(--color-brand-500) 35%, transparent), transparent 55%),
			radial-gradient(circle at 85% 90%, color-mix(in oklab, var(--color-sun-400) 18%, transparent), transparent 50%),
			linear-gradient(135deg, var(--color-ink-700), var(--color-ink-950));

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			background-image:
				linear-gradient(to right, var(--color-border) 1px, transparent 1px),
				linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
			background-size: 2rem 2rem;
			mask-image: radial-gradient(ellipse at center, black, transparent 75%);
		}

		&.has-preview::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(to top, rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.35));
		}
	}

	.project-image-preview {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transition: scale 0.6s var(--ease-out-expo);

		.project:has(.project-link:hover) & {
			scale: 1.05;
		}
	}

	.project-image-logo {
		position: relative;
		z-index: 1;
		block-size: 5.5rem;
		inline-size: auto;
		max-inline-size: 60%;
		object-fit: contain;
		filter: drop-shadow(0 12px 32px rgb(0 0 0 / 0.55));
		transition: scale 0.5s var(--ease-out-expo);

		.project:has(.project-link:hover) & {
			scale: 1.06;
		}
	}

	.project-monogram {
		position: relative;
		z-index: 1;
		font-size: 5rem;
		font-weight: 900;
		line-height: 1;
		background-image: var(--gradient-brand);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		transition: scale 0.5s var(--ease-out-expo);

		.project:has(.project-link:hover) & {
			scale: 1.06;
		}
	}

	/* ---------- Info ---------- */
	.project-info {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
	}

	.project-title {
		color: var(--color-fg);
		font-size: 1.75rem;
		font-weight: 800;
	}

	.project-link {
		color: inherit;
		text-decoration: none;

		/* Stretch the link over the whole card */
		&::after {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 2;
		}

		&:focus-visible {
			outline: none;
		}
	}

	.project-description {
		color: var(--color-fg-muted);
		font-size: 1.0625rem;
	}

	.project-technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
	}

	/* ---------- Actions ---------- */
	.project-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		/* Repo button height: CTAs line up across cards with and without it */
		min-block-size: 2.25rem;
		margin-block-start: auto;
		padding-block-start: 0.5rem;
		box-sizing: content-box;
	}

	.project-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--color-accent-text);
		font-weight: 700;
	}

	.project-cta :global(.project-cta-icon) {
		inline-size: 1.125rem;
		block-size: 1.125rem;
		transition: translate 0.3s var(--ease-out-expo);
	}

	@media (prefers-reduced-motion: no-preference) {
		.project:has(.project-link:hover) :global(.project-cta-icon) {
			translate: 0.2rem -0.2rem;
		}
	}

	/* Independent action: above the stretched link's overlay (z-index 2) */
	.project-repo {
		position: relative;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.875rem;
		border: 1px solid var(--color-border-control);
		border-radius: 999px;
		color: var(--color-fg-muted);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;

		&:hover {
			border-color: var(--color-fg-muted);
			color: var(--color-fg);
		}
	}

	.project-repo :global(.project-repo-icon) {
		flex-shrink: 0;
		inline-size: 1rem;
		block-size: 1rem;
	}

	@media (forced-colors: active) {
		.project {
			border-color: CanvasText;
		}
	}
</style>
