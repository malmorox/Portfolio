---
import workExperienceData from '@data/work-experience.json';
import { HiArrowUpRight } from 'react-icons/hi2';

const companies = workExperienceData.companies;

const companyLogosPath = "/images/work-experience/"
---
<section id="about" class="section-space" tabindex="-1" aria-labelledby="about-title">
    <div class="page-container">
        <!-- No visible title: the lead paragraph opens the section. Keeps the h1 → h2 → h3 outline -->
        <h2 id="about-title" class="visually-hidden">Sobre mí</h2>

        <div class="about-grid">
            <div class="about-text reveal">
                <p class="about-text-main">
                    ¡Hola! Soy Marcos, <strong>técnico</strong> en <strong>Desarrollo de Aplicaciones Web</strong>{" "}
                    y <strong>Multiplataforma</strong>.
                    Creo aplicaciones <em>modernas, escalables</em> y con una
                    excelente <em>experiencia de usuario</em>.
                </p>
                <p class="about-text-sub">
                    Me preocupo por escribir código limpio y bien estructurado, construyendo soluciones
                    sólidas, fáciles de mantener y pensadas para quien las usa.
                </p>
            </div>

            <aside class="work-experience reveal" aria-labelledby="work-label">
                <h3 id="work-label" class="work-label">Experiencia laboral</h3>
                <ul class="companies-list">
                    {companies.map((company) => (
                        <li>
                            <a href={company.url} target="_blank" rel="noopener" class="company-link">
                                <img
                                    src={`${companyLogosPath}${company.logo}`}
                                    alt={company.name}
                                    class="company-logo"
                                    style={`--logo-height: ${company.logo_height / 16}rem`}
                                    loading="lazy"
                                    decoding="async"
                                />
                                <HiArrowUpRight className="company-icon" aria-hidden="true" />
                            </a>
                            {/* {company.current && <span class="current-badge">Actual</span>} */}
                        </li>
                    ))}
                </ul>
            </aside>
        </div>
    </div>
</section>

<style>
    .about-grid {
        display: grid;
        gap: clamp(2.5rem, 2rem + 3vw, 5rem);
        align-items: start;

        @media (min-width: 60rem) {
            grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        }
    }

    .about-text {
        display: grid;
        gap: 1.75rem;
    }

    .about-text-main {
        color: var(--color-fg-muted);
        font-size: var(--text-lead);
        font-weight: 600;
        line-height: 1.45;

        & strong {
            color: var(--color-accent-text);
            font-weight: 700;
        }

        & em {
            color: var(--color-fg);
        }
    }

    .about-text-sub {
        max-inline-size: 55ch;
        color: var(--color-fg-subtle);
        font-size: 1.125rem;
    }

    /* ---------- Experience ---------- */
    .work-experience {
        --card-padding: clamp(1.5rem, 1.25rem + 1vw, 2rem);
        /* How far the hover background bleeds past the logo row */
        --row-bleed: 0.75rem;

        padding: var(--card-padding);
        /* Same gap below the last hover background as on its sides */
        padding-block-end: calc(var(--card-padding) - var(--row-bleed));
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card-brand);
        background-color: var(--color-surface);
        box-shadow: var(--shadow-card);
    }

    .work-label {
        margin-block-end: 1rem;
        color: var(--color-fg-subtle);
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .companies-list {
        display: grid;
        list-style: none;

        & li:not(:last-child) {
            border-block-end: 1px solid var(--color-border);
        }
    }

    .company-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-block-size: 4.5rem;
        padding-inline: var(--row-bleed);
        margin-inline: calc(var(--row-bleed) * -1);
        border-radius: 0.75rem;
        transition: background-color 0.2s ease;

        &:hover {
            background-color: rgb(255 255 255 / 0.04);
        }
    }

    .company-logo {
        block-size: var(--logo-height);
        inline-size: auto;
        max-inline-size: 70%;
        object-fit: contain;
        filter: brightness(0) invert(1);
        opacity: 0.65;
        transition: opacity 0.3s ease;

        .company-link:is(:hover, :focus-visible) & {
            opacity: 1;
        }
    }

    .company-link :global(.company-icon) {
        inline-size: 1.25rem;
        block-size: 1.25rem;
        color: var(--color-fg-subtle);
        transition:
            color 0.2s ease,
            translate 0.3s var(--ease-out-expo);
    }

    .company-link:hover :global(.company-icon) {
        color: var(--color-accent-text);

        @media (prefers-reduced-motion: no-preference) {
            translate: 0.15rem -0.15rem;
        }
    }

    .current-badge {
        padding: 0.125rem 0.375rem;
        border: 1px solid var(--color-sun-400);
        border-radius: 0.25rem;
        color: var(--color-sun-400);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
</style>
