---
import BaseLayout from "@layouts/BaseLayout.astro";
import projectsData from "@data/projects.json";
import { iconMap } from "@utils/iconMap";

const projects = projectsData.projects;

function toSlug(name: string) {
  return name.toLowerCase().replace(/\s+/g, "-");
}
---

<BaseLayout title="Proyectos — Marcos Almorox" description="Todos mis proyectos">
  <main class="projects-page">

    <!-- Header -->
    <header class="page-header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Volver
      </a>
      <div class="header-content">
        <p class="header-eyebrow">Portafolio</p>
        <h1 class="header-title">Proyectos</h1>
        <p class="header-subtitle">
          Una selección de lo que he construido. Desde apps móviles hasta herramientas web.
        </p>
      </div>
      <div class="header-count">
        <span class="count-number">{projects.length}</span>
        <span class="count-label">proyectos</span>
      </div>
    </header>

    <!-- Grid -->
    <section class="projects-grid">
      {projects.map((project, i) => {
        const slug = toSlug(project.name);
        return (
          <a href={`/projects/${slug}`} class="project-card">
            <div class="card-index">0{i + 1}</div>

            <div class="card-body">
              <div class="card-top">
                <h2 class="card-title">{project.name}</h2>
                <svg class="card-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7v10"/>
                </svg>
              </div>

              <p class="card-desc">{project.description}</p>

              <div class="card-footer">
                <div class="card-techs">
                  {project.technologies.slice(0, 4).map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                  {project.technologies.length > 4 && (
                    <span class="tech-tag muted">+{project.technologies.length - 4}</span>
                  )}
                </div>

                <div class="card-preview">
                  <img src={project.img_preview} alt={project.name} />
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </section>

  </main>
</BaseLayout>

<style>
  .projects-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 8rem;
    font-family: "Satoshi", sans-serif;
  }

  /* ── Header ── */
  .page-header {
    position: relative;
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255,255,255,0.35);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 2.5rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: rgba(255,255,255,0.7); }

  .header-content {
    max-width: 600px;
  }

  .header-eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(244, 114, 38, 0.8);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .header-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .header-subtitle {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    max-width: 50ch;
  }

  .header-count {
    position: absolute;
    right: 0;
    bottom: 3rem;
    text-align: right;
  }

  .count-number {
    display: block;
    font-size: 5rem;
    font-weight: 800;
    color: rgba(244, 114, 38, 0.15);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .count-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.2);
  }

  /* ── Grid ── */
  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: rgba(255,255,255,0.06);
    border-radius: 16px;
    overflow: hidden;
  }

  /* ── Card ── */
  .project-card {
    display: flex;
    gap: 2rem;
    padding: 2rem 2rem;
    background: rgb(31, 31, 31);
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }

  .project-card:hover {
    background: rgba(244, 114, 38, 0.04);
  }

  .project-card:hover .card-arrow {
    transform: translate(3px, -3px);
    stroke: rgba(244, 114, 38, 0.9);
  }

  .project-card:hover .card-title {
    color: rgba(244, 114, 38, 0.9);
  }

  .card-index {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.2);
    padding-top: 0.3rem;
    min-width: 28px;
    letter-spacing: 0.05em;
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .card-arrow {
    flex-shrink: 0;
    color: rgba(255,255,255,0.2);
    transition: transform 0.25s, stroke 0.2s;
    margin-top: 0.2rem;
  }

  .card-desc {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.65;
    max-width: 65ch;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .card-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tag {
    font-size: 0.72rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .tech-tag.muted {
    border-color: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.25);
  }

  .card-preview {
    width: 100px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }

  .card-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .project-card:hover .card-preview img {
    opacity: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .header-count { display: none; }
    .card-preview { display: none; }
    .project-card { flex-direction: column; gap: 0.5rem; }
  }
</style>